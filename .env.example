# Copy to .env.local (git-ignored) for local development.
# On Netlify, set the same variable under Site configuration → Environment variables.
#
# OAuth 2.0 Client ID of type "Web application" from Google Cloud Console,
# with http://localhost:5173 and your Netlify site URL as authorised
# JavaScript origins. See README → "Google Drive sync".
VITE_GOOGLE_CLIENT_ID=
