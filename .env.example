# Copy to .env.local (git-ignored) for local development.
# On Netlify, set the same variable under Site configuration → Environment variables.
#
# OAuth 2.0 Client ID of type "Web application" from Google Cloud Console,
# with http://localhost:5173 and your Netlify site URL as authorised
# JavaScript origins. See README → "Google Drive sync".
VITE_GOOGLE_CLIENT_ID=

# Optional: keep the Drive sign-in alive for months instead of an hour.
# Needs the Netlify function in netlify/functions/drive-auth.mjs, which uses
# the OAuth client secret (server only — never put it in a VITE_ variable)
# and a long random string to encrypt the refresh-token cookie.
# Set all three on Netlify; locally, `netlify dev` serves the function too.
#
#   openssl rand -base64 48    → a value for DRIVE_COOKIE_SECRET
#
VITE_DRIVE_SERVER_AUTH=1
GOOGLE_CLIENT_SECRET=
DRIVE_COOKIE_SECRET=
